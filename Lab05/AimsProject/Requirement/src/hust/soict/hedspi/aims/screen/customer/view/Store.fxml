<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_LEFT" prefHeight="768.0" prefWidth="1028.0"
	xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1">

	<children>
		<!-- Header bar -->
		<HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="20.0">
			<padding>
				<Insets top="10" right="10" bottom="10" left="10" />
			</padding>
			<children>
				<Label text="AIMS Store" textFill="#004cff">
					<font>
						<Font size="40.0" />
					</font>
				</Label>
				<Region HBox.hgrow="ALWAYS" />
				<Button text="View Cart" fx:id="btnViewCart"
					onAction="#btnViewCartPressed" prefWidth="100" prefHeight="40" />
			</children>
		</HBox>

		<!-- Search bar -->
		<HBox spacing="10" alignment="CENTER_LEFT">
			<padding>
				<Insets top="10" right="10" bottom="10" left="10" />
			</padding>
			<children>
				<Label text="Filter by Title:" />
				<TextField fx:id="tfFilterTitle"
					promptText="Enter media title..." prefWidth="200" />
			</children>
		</HBox>

		<!-- Scrollable content -->
		<ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
			<content>
				<FlowPane fx:id="flowPane" hgap="20" vgap="20" prefWrapLength="900">
					<padding>
						<Insets top="10" right="10" bottom="10" left="10"/>
					</padding>
				</FlowPane>
			</content>
		</ScrollPane>
	</children>
</VBox>
